        <file alias="icons/classic/24px/pause.svg">icons/classic/24px/pause.svg</file>
        <file alias="icons/classic/24px/person.svg">icons/classic/24px/person.svg</file>
        <file alias="icons/classic/24px/phone.svg">icons/classic/24px/phone.svg</file>
        <file alias="icons/classic/24px/play_arrow.svg">icons/classic/24px/play_arrow.svg</file>
        <file alias="icons/classic/24px/refresh.svg">icons/classic/24px/refresh.svg</file>
        <file alias="icons/classic/24px/search.svg">icons/classic/24px/search.svg</file>
        <file alias="icons/classic/24px/settings.svg">icons/classic/24px/settings.svg</file>
        <file alias="icons/classic/24px/share.svg">icons/classic/24px/share.svg</file>
        <file alias="icons/classic/24px/shopping_cart.svg">icons/classic/24px/shopping_cart.svg</file>
